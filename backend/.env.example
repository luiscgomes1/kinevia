# Banco de dados PostgreSQL (ex: Supabase, Neon, Render)
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"

# Ambiente (production, development, test)
NODE_ENV="development"

# Segredo para assinar cookies (use um valor único, ex: openssl rand -hex 32)
COOKIE_SECRET="seu-cookie-secret-aqui"

# Chaves JWT (gere valores únicos para cada ambiente)
JWT_SECRET="sua-chave-secreta-aqui-altere"
JWT_REFRESH_SECRET="sua-chave-refresh-aqui-altere"

# Porta do servidor
PORT=3333

# Expiração dos tokens
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# URL do frontend (para CORS)
FRONTEND_URL="http://localhost:5173"

# Nível de log (trace, debug, info, warn, error, fatal)
LOG_LEVEL="info"

# Habilita o Swagger em produção (em dev já é habilitado automaticamente)
# SWAGGER_ENABLED="true"

# === Supabase Storage (upload de assinatura, logo, laudos) ===
# URL do projeto (encontrada em Settings → API → Project URL)
SUPABASE_URL="https://seu-projeto.supabase.co"
# Chave service_role (Settings → API → service_role key)
# ATENÇÃO: use apenas no backend, NUNCA no frontend
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
# Nome do bucket criado no Supabase Storage Dashboard
SUPABASE_STORAGE_BUCKET="kinevia"

# === E-mail (esqueci minha senha, notificações, lembretes) ===
# Deixe SMTP_HOST vazio para modo dev (notificações ignoradas, token retornado na resposta)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-de-app"
# SMTP_FROM="noreply@kinevia.app"

# === Deploy serverless (Vercel) ===
# Segredo que protege a rota de cron POST /cron/lembrete (Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET="seu-cron-secret-aqui"
